<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.intel.cosbench.shadow</groupId>
    <artifactId>cosbench-scheme3-shadow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>cosbench-provider-spike</artifactId>
  <name>COSBench Provider SPI Coexistence Spike</name>

  <dependencies>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-sineio</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-s3</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-api-shadow</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>test-only-mock-provider-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../dev/cosbench-mock/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testIncludes>
            <testInclude>com/intel/cosbench/api/mock/**/*.java</testInclude>
            <testInclude>com/intel/cosbench/shadow/provider/**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
