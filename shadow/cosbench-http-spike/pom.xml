<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.intel.cosbench.shadow</groupId>
    <artifactId>cosbench-scheme3-shadow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>cosbench-http-spike</artifactId>
  <name>COSBench authenticated Driver HTTP spike</name>

  <dependencies>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-api-shadow</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-core-shadow</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-http-shadow</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.intel.cosbench.shadow</groupId>
      <artifactId>cosbench-config-shadow</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.codehaus.jackson</groupId>
      <artifactId>jackson-mapper-asl</artifactId>
      <version>1.9.13</version>
    </dependency>
    <dependency>
      <groupId>commons-lang</groupId>
      <artifactId>commons-lang</artifactId>
      <version>2.6</version>
    </dependency>
    <dependency>
      <groupId>commons-beanutils</groupId>
      <artifactId>commons-beanutils</artifactId>
      <version>1.9.4</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>legacy-driver-api-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../dev/cosbench-driver/src</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>legacy-driver-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../dev/cosbench-mock/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>com/intel/cosbench/http/**/*.java</include>
            <include>com/intel/cosbench/driver/agent/**/*.java</include>
            <include>com/intel/cosbench/driver/generator/**/*.java</include>
            <include>com/intel/cosbench/driver/iterator/**/*.java</include>
            <include>com/intel/cosbench/driver/model/**/*.java</include>
            <include>com/intel/cosbench/driver/operator/**/*.java</include>
            <include>com/intel/cosbench/driver/repository/**/*.java</include>
            <include>com/intel/cosbench/driver/service/COSBDriverService.java</include>
            <include>com/intel/cosbench/driver/service/COSBDriverServiceFactory.java</include>
            <include>com/intel/cosbench/driver/service/COSBAuthAPIService.java</include>
            <include>com/intel/cosbench/driver/service/COSBStorageAPIService.java</include>
            <include>com/intel/cosbench/driver/service/MissionHandler.java</include>
            <include>com/intel/cosbench/driver/util/**/*.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/intel/cosbench/http/**/*.java</testInclude>
            <testInclude>com/intel/cosbench/api/mock/**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>false</failIfNoTests>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
          <workingDirectory>${project.build.directory}</workingDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
